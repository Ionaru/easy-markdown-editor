{
    "name": "easymde",
    "version": "3.0.0-beta.1",
    "description": "A simple, beautiful, and embeddable JavaScript Markdown editor, built on CodeMirror 6. Ships as an ESM class API and an <easy-markdown-editor> web component.",
    "keywords": [
        "codemirror",
        "codemirror6",
        "easymde",
        "editor",
        "esm",
        "markdown",
        "markdown-editor",
        "typescript",
        "web-component"
    ],
    "homepage": "https://github.com/Ionaru/easy-markdown-editor#readme",
    "bugs": {
        "url": "https://github.com/Ionaru/easy-markdown-editor/issues"
    },
    "license": "MIT",
    "author": "Jeroen Akkerman",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ionaru/easy-markdown-editor.git"
    },
    "files": [
        "dist",
        "!dist/**/*.map",
        "CHANGELOG.md",
        "MIGRATION.md"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": "./dist/index.mjs",
        "./package.json": "./package.json",
        "./style.css": "./dist/style.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "dev:app": "vp dev --port 5173 --strictPort",
        "fix": "vp check --fix",
        "test": "vp test",
        "check": "vp check",
        "release": "bumpp",
        "prepublishOnly": "vp run build"
    },
    "devDependencies": {
        "@codemirror/commands": "^6.10.4",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.8",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@lezer/highlight": "^1.2.3",
        "@lezer/markdown": "^1.7.2",
        "@tsdown/css": "^0.22.14",
        "@types/node": "^26.2.0",
        "@vitest/browser-playwright": "catalog:",
        "bumpp": "^12.2.0",
        "dompurify": "^3.4.13",
        "escape-string-regexp": "^5.0.0",
        "marked": "^18.0.9",
        "playwright": "^1.62.1",
        "sass-embedded": "^1.100.0",
        "typescript": "^7.0.2",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:"
    },
    "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
    "inlinedDependencies": {
        "@codemirror/autocomplete": "6.20.3",
        "@codemirror/commands": "6.10.4",
        "@codemirror/lang-css": "6.3.1",
        "@codemirror/lang-html": "6.4.12",
        "@codemirror/lang-javascript": "6.2.5",
        "@codemirror/lang-markdown": "6.5.2",
        "@codemirror/language": "6.12.4",
        "@codemirror/state": "6.7.1",
        "@codemirror/view": "6.43.8",
        "@fortawesome/fontawesome-common-types": "7.3.1",
        "@fortawesome/fontawesome-svg-core": "7.3.1",
        "@fortawesome/free-solid-svg-icons": "7.3.1",
        "@lezer/common": "1.5.2",
        "@lezer/css": "1.3.6",
        "@lezer/highlight": "1.2.3",
        "@lezer/html": "1.3.13",
        "@lezer/javascript": "1.5.4",
        "@lezer/lr": "1.4.10",
        "@lezer/markdown": "1.7.2",
        "@marijn/find-cluster-break": "1.0.3",
        "dompurify": "3.4.13",
        "escape-string-regexp": "5.0.0",
        "marked": "18.0.9",
        "style-mod": "4.1.3",
        "w3c-keyname": "2.2.8"
    }
}
